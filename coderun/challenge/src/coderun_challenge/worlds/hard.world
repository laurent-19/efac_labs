# hard.world - CodeRun HARD arena (12 x 12 m): staggered walls and pillars.
# Obstacles live in bitmaps/hard.png (generated by tools/gen_maps.py). The start pose below
# must match config/hard_goals.yaml.

include "include/robots.inc"

resolution 0.02
interval_sim 100

define floorplan model
(
  color "gray30"
  boundary 1
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

window
(
  size [ 700.000 700.000 ]
  scale 55.0
  center [ 0.0 0.0 ]
  rotate [ 0 0 ]
  show_data 1
)

floorplan
(
  name "hard"
  size [12.000 12.000 0.800]
  pose [0 0 0 0]
  bitmap "../bitmaps/hard.png"
  gui_move 0
)

pioneer2dx_with_laser
(
  name "robot_0"
  color "red"
  pose [ -5.0 -5.2 0 0 ]
  odom_error [ 0.01 0.01 0.0 0.02 ]
)
