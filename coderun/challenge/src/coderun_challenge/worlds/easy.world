# easy.world - CodeRun EASY arena (12 x 12 m), based on the Lab 2 "cave" world.
# Obstacles live in bitmaps/easy.png (generated by tools/gen_maps.py); the scorer
# reads the same bitmap, so do not edit one without regenerating the other.

include "include/robots.inc"

resolution 0.02
interval_sim 100

define floorplan model
(
  color "gray30"
  boundary 1
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

window
(
  size [ 700.000 700.000 ]
  scale 55.0
  center [ 0.0 0.0 ]
  rotate [ 0 0 ]
  show_data 1
)

floorplan
(
  name "easy"
  size [12.000 12.000 0.800]
  pose [0 0 0 0]
  bitmap "../bitmaps/easy.png"
  gui_move 0
)

# waypoint markers (visual only: no laser/obstacle return)
define marker model
(
  size [0.4 0.4 0.02]
  gui_nose 0
  obstacle_return 0
  laser_return 0
  ranger_return 0
  gui_outline 0
)
marker( pose [  4.0 -4.0 0 0 ] color "green" )
marker( pose [  4.0  4.0 0 0 ] color "yellow" )
marker( pose [ -4.0  4.0 0 0 ] color "blue" )

pioneer2dx_with_laser
(
  name "robot_0"
  color "red"
  pose [ -5.0 -5.0 0 45 ]
  odom_error [ 0.01 0.01 0.0 0.02 ]
)
